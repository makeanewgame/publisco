{
  "permissions": {
    "allow": [
      "Bash(pnpm prisma *)",
      "mcp__plugin_context-mode_context-mode__ctx_search"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-worker-deps.sh",
            "timeout": 15,
            "statusMessage": "Checking worker server-package docs..."
          }
        ]
      }
    ]
  }
}
