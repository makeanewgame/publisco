generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum MembershipTier {
  FREE
  PREMIUM
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  avatarUrl    String?

  provider     AuthProvider @default(LOCAL)
  googleId     String?      @unique

  emailVerified Boolean @default(false)

  // Hesap açılırken frontend'in aktif dilinden yakalanır; e-posta
  // şablonlarının (doğrulama, şifre sıfırlama) hangi dilde gönderileceğini belirler.
  locale String @default("tr")

  membershipTier MembershipTier @default(FREE)
  // Kullanıcının hesabı boyunca dönüştürdüğü toplam kaynak dosya boyutu (bayt).
  // Free kullanıcılar için 200MB'lık dönüşüm kotasına karşı kontrol edilir;
  // premium'da limit yok ama sayaç yine de tutulur. Hiçbir zaman resetlenmez.
  convertedBytesTotal BigInt @default(0)

  // Lemon Squeezy'deki müşteri kaydına karşılık gelir; ilk checkout webhook'unda
  // doldurulur. Aynı kullanıcının sonraki webhook'larını (custom_data.user_id
  // olmadan da) müşteri bazında eşleştirmek için tutuluyor.
  lemonSqueezyCustomerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens        RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  fileAssets            FileAsset[]
  quota                 UserQuota?
  subscriptions          Subscription[]
  convertJobs            ConvertJob[]

  @@map("users")
}

// Kullanıcı bazlı kota limitleri. Üyelik oluşturulurken (bkz. UsersService)
// o anki membershipTier'a karşılık gelen QUOTA_BYTES sabitlerinden dolduruluyor,
// böylece ileride bir kullanıcıya özel (tier'dan bağımsız) limit tanımlanabilir.
model UserQuota {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  storageQuotaBytes   BigInt
  // null = sınırsız (premium dönüşüm kotası)
  converterQuotaBytes BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_quotas")
}

// Vercel Blob'da saklanan bir dosyanın DB tarafındaki kaydı.
// `pathname` blob store'daki sabit/stabil depolama anahtarıdır; rename sadece
// `fileName` (kullanıcıya gösterilen ad) üzerinde çalışır, blob'u taşımaz.
model FileAsset {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  fileName    String
  pathname    String   @unique
  url         String
  contentType String?
  size        Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@map("file_assets")
}

// Bir kullanıcının aktif oturumlarını (cihazlarını) temsil eder.
// Sign out akışı burada ilgili kaydı revokedAt ile iptal eder,
// böylece diğer cihazlardaki oturumlar etkilenmez.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  userAgent String?
  ipAddress String?

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 6 haneli kodun hash'i. Kod, tam token'ın aksine global olarak benzersiz
  // değildir (iki kullanıcı aynı anda aynı kodu alabilir), bu yüzden lookup
  // userId üzerinden yapılır ve tokenHash artık @unique değildir.
  tokenHash  String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Worker'a devredilmiş bir dönüştürme job'ının hangi kullanıcıya ait olduğunu
// ve kotasının serbest bırakılıp bırakılmadığını takip eder (bkz. ConvertService).
// `id` worker'ın döndürdüğü job_id ile aynıdır (worker kendi job'larını bilir
// ama kimlik doğrulaması yapmaz, bkz. apps/worker/app/jobs.py). Bu eşleme
// bilinçli olarak bellek-içi bir Map yerine burada tutuluyor: `apps/api`
// Vercel'de serverless çalışıyor, instance'lar arasında bellek paylaşılmıyor —
// uzun süren (çok sayfalı) dönüşümlerde status polling'in bir kısmı job'ı
// oluşturan instance'tan farklı bir instance'a düşüp yanlışlıkla 404 dönebiliyordu.
model ConvertJob {
  id     String @id
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fileSizeBytes Int
  released      Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("convert_jobs")
}

// Lemon Squeezy'deki bir aboneliğin DB tarafındaki aynası. Webhook'lar
// (subscription_created/updated/cancelled/expired/resumed) bu satırı upsert
// eder; asıl doğruluk kaynağı Lemon Squeezy'dir, burası sadece son bilinen
// durumu tutar (bkz. PaymentsService).
model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lemonSqueezySubscriptionId String @unique
  variantId                  String
  // Lemon Squeezy'nin ham durum string'i: active/on_trial/cancelled/expired/past_due/paused/unpaid.
  status                     String
  renewsAt                   DateTime?
  endsAt                     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("subscriptions")
}
